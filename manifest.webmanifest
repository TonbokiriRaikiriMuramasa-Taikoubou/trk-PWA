{
  "name": "trk! — AGRG",
  "short_name": "trk!",
  "description": "手持ちの曲で遊べる、非営利のオープンなブラウザ音ゲー。MANUAL・TRUCK・ORBIT・STAGE・CATCHの5モード。",
  "lang": "ja",
  "dir": "ltr",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "fullscreen"],
  "orientation": "any",
  "background_color": "#07080d",
  "theme_color": "#07080d",
  "categories": ["games", "music", "entertainment"],
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-180.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon-1024.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "media", "accept": ["audio/*", "video/*", ".mid", ".midi"] },
        { "name": "packs", "accept": ["application/octet-stream", ".stpack"] },
        { "name": "books", "accept": ["application/vnd.comicbook+zip", ".cbz", "application/zip", ".zip"] }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "launch_type": "single-client",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "accept": {
        "audio/*": [],
        "video/*": [],
        "application/vnd.comicbook+zip": [".cbz"],
        "application/zip": [".zip"],
        "application/octet-stream": [".stpack"]
      }
    }
  ]
}
